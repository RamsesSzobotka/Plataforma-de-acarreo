# ==========================================
# PLATAFORMA DE ACARREOS - Variables de Entorno
# ==========================================

# --------------------------------------------------
# Base de Datos (MongoDB Locale con Docker)
# --------------------------------------------------
DATABASE_URL=mongodb://admin:password@localhost:27017/plataforma_acarreo?authSource=admin

# --------------------------------------------------
# Autenticación (Clerk)
# --------------------------------------------------
# Obtené tus keys en https://clerk.com (Dashboard > API Keys)
CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxx

# URL pública del frontend (usado para redirects OAuth al frontend)
# Ej: https://carglyn-frontend.onrender.com
# REQUERIDO para el flujo OAuth 2.1 con Claude Desktop

# --------------------------------------------------
# Pagos (Stripe)
# --------------------------------------------------
# Obtené tus keys en https://dashboard.stripe.com (Developers > API keys)
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# --------------------------------------------------
# Redis (cache de tracking en tiempo real)
# --------------------------------------------------
# En Docker: redis://redis:6379
# Local: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# --------------------------------------------------
# Email (Gmail SMTP with App Password)
# --------------------------------------------------
# Gmail App Password Setup:
# 1. Enable 2FA on your Google Account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create a new App Password (select "Other" → "Nodemailer")
# 4. Copy the 16-character password and paste in SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tuemail@gmail.com
SMTP_PASS=xxxx-app-password-xxxx
EMAIL_FROM=noreply@tudominio.com

# --------------------------------------------------
# MCP Server (Model Context Protocol)
# --------------------------------------------------
# Clave secreta para firmar los JWTs de OAuth (generar con: openssl rand -hex 32)
MCP_JWT_SECRET=genera_una_clave_hex_64_chars_aqui

# URL pública del servidor MCP (para OAuth y Claude Desktop)
# Ej: https://carglyn.onrender.com
MCP_PUBLIC_URL=http://localhost:3000

# --------------------------------------------------
# Servidor
# --------------------------------------------------
PORT=3000
NODE_ENV=development