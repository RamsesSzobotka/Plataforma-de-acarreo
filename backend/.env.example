# ==========================================
# PLATAFORMA DE ACARREOS - Variables de Entorno
# ==========================================

# --------------------------------------------------
# Base de Datos (MongoDB Locale con Docker)
# --------------------------------------------------
DATABASE_URL=mongodb://admin:password@localhost:27017/plataforma_acarreo?authSource=admin

# --------------------------------------------------
# Autenticación (Clerk)
# --------------------------------------------------
# Obtené tus keys en https://clerk.com (Dashboard > API Keys)
CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxx

# --------------------------------------------------
# Pagos (Stripe)
# --------------------------------------------------
# Obtené tus keys en https://dashboard.stripe.com (Developers > API keys)
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# --------------------------------------------------
# Servidor
# --------------------------------------------------
PORT=3000
NODE_ENV=development

# --------------------------------------------------
# Cloudinary (Subida de imágenes)
# --------------------------------------------------
# Obtené tus keys en https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=xxxxx
CLOUDINARY_API_KEY=xxxxx
CLOUDINARY_API_SECRET=xxxxx