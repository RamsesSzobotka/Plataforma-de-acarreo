{
  "name": "plataforma-de-acarreo-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target node",
    "db:up": "docker compose -f docker-compose.yml up -d",
    "db:down": "docker compose -f docker-compose.yml down",
    "db:logs": "docker compose -f docker-compose.yml logs -f"
  },
  "dependencies": {
    "@clerk/clerk-sdk-node": "^5.0.0",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "hono": "^4.0.0",
    "mongoose": "^8.9.0",
    "stripe": "^17.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/cors": "^2.8.17",
    "typescript": "^5.7.0"
  }
}