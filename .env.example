# ═══════════════════════════════════════════════════════════════
# Plataforma de Acarreos — Variables de Entorno
# ═══════════════════════════════════════════════════════════════
# Copia este archivo como .env y completa los valores reales:
#   cp .env.example .env
#
# Docker Compose carga estas variables automáticamente.
# ═══════════════════════════════════════════════════════════════

# ── Backend ──────────────────────────────────────────────────
# MongoDB (localhost para desarrollo local, Docker override en compose)
DATABASE_URL=mongodb://admin:password@localhost:27017/plataforma_acarreo

# Clerk (https://dashboard.clerk.com)
CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxx

# Stripe (https://dashboard.stripe.com)
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Cloudinary (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=xxxxx
CLOUDINARY_API_KEY=xxxxx
CLOUDINARY_API_SECRET=xxxxx

# Gmail SMTP Email (https://support.google.com/accounts/answer/185833)
# Gmail App Password Setup:
# 1. Enable 2FA on your Google Account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create a new App Password (select "Other" → "Nodemailer")
# 4. Copy the 16-character password and paste in SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tuemail@gmail.com
SMTP_PASS=xxxx-app-password-xxxx
EMAIL_FROM=noreply@tudominio.com
FRONTEND_URL=http://localhost:5173 #link de lso botones de lso templates de lso correos

# Servidor
PORT=3000
NODE_ENV=development

# ── Frontend ──────────────────────────────────────────────────
# Clerk publishable key (frontend)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx

# Stripe publishable key (frontend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# Cloudinary cloud name (frontend)
VITE_CLOUDINARY_CLOUD_NAME=xxxxx

# ⚠️ VITE_API_URL se deja vacío en Docker para usar el proxy de Vite
# En desarrollo local sin Docker, descomenta la línea de abajo:
VITE_API_URL=http://localhost:3000
